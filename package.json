{
  "name": "neopian-assistant",
  "version": "7.13.0",
  "private": true,
  "description": "An unofficial Chrome extension providing dailies, pricing, shop, and productivity tools for Neopets.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:branch": "node scripts/validate-branch-name.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run format:check && npm run lint && npm test && npm run build && npm run validate && npm run secret-scan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtaitt-dev/Neopian-Assistant.git"
  },
  "bugs": {
    "url": "https://github.com/jtaitt-dev/Neopian-Assistant/issues"
  },
  "homepage": "https://github.com/jtaitt-dev/Neopian-Assistant#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "esbuild": "0.25.6",
    "fflate": "0.8.2",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "sharp": "0.35.3"
  }
}
